Algoritmo Relación_Enteros
	
	Definir a, b como enteros
	
	Escribir "Por favor ingrese dos valores enteros";
	Leer a, b;
	Si a = b Entonces
		Escribir "los dos valores ingresados son iguales"
	SiNo
		Si a > b Entonces
			Escribir "El primer valor es mayor que el segundo";
		SiNo
			Escribir "El primer valor es menor que el segundo"
		FinSi
	FinSi
	
FinAlgoritmo
