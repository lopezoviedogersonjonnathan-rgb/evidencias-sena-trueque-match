Algoritmo OperadoresAritmeticos
	Definir a, b, suma, resta, multiplicación como enteros;
	
	Escribir "Por favor ingrese el primer #";
	leer a;
	Escribir "Por favor ingrese el segundo #";
	Leer b;	
	
	Escribir "el resultado de sumar ", a," con ", b, " es:";
	suma <- (a+b);
    Escribir suma;
	
	resta <- (a-b)	
	Escribir "el resultado de restar ", a," con ", b, " es:";
	Escribir Resta;
	
	multiplicación <- (a*b)	
	Escribir "el resultado de multiplicar ", a," con ", b, " es:";
	Escribir multiplicación;
	
	Divición <- (a/b)	
	Escribir "el resultado de multiplicar ", a," con ", b, " es:";
	Escribir multiplicación;
	
	
	Divición <- (a/b)	
	Escribir "el resultado de dividir", a," con ", b, " es:";
	Escribir Divición;
	
	//Mod <- (a/b = Residuo)	
	Escribir "el resultado de DIVIDIR ", a," con ", b, " es:";
	Escribir (a % b);//Nos da como resultado el residuo
    
FinAlgoritmo
