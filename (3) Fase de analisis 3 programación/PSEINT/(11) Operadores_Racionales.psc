Algoritmo Operadores_Racionales
	
	Definir A, B Como Entero;
	Definir Resultado Como Logico;
	A <- 5;
	B <- 6;
	
	Resultado <- A = 5;
	Escribir Resultado;
	
FinAlgoritmo

